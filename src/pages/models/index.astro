---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { models } from '../../data/models';
import { fmtPrice, fmtContext } from '../../data/comparisons';

const providers: Array<'OpenAI' | 'Anthropic' | 'Google'> = ['OpenAI', 'Anthropic', 'Google'];
const groups = providers.map((p) => ({ provider: p, list: models.filter((m) => m.provider === p) }));
const lastCheck = [...new Set(models.map((m) => m.lastChecked))].sort().pop();

const faqs = [
  {
    q: 'How many LLM models does this site track?',
    a: `${models.length} models across OpenAI, Anthropic and Google — every one with input, cached input and output rates plus its context window. Each profile carries its own verification date from our pricing database, re-checked against official provider pages on the first of every month.`,
  },
  {
    q: 'Which model is the cheapest right now?',
    a: 'GPT-5 nano at $0.05 per 1M input tokens and $0.40 per 1M output tokens, verified against OpenAI\'s official pricing page. Gemini 3.5 Flash-Lite is the cheapest Google option at $0.30 in / $2.50 out, and Claude Haiku 4.5 the cheapest Anthropic model at $1.00 in / $5.00 out.',
  },
  {
    q: 'Why do some models have the same price?',
    a: 'Providers often reuse pricing across generations — GPT-5.5 and GPT-5.6 Sol both cost $5.00 in / $30.00 out per 1M tokens. When a provider changes rates, we update the whole affected family in one pass; every row shows the date it was last verified.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title="All LLM Models — Pricing & Context Profiles"
  description={`Browse all ${models.length} tracked LLM models from OpenAI, Anthropic and Google. Each profile: input, cached and output rates per 1M tokens, context window in words and pages, and monthly cost at real workloads.`}
  dateModified={lastCheck}
  extraSchemas={[faqSchema]}
>
  <article>
    <header class="max-w-2xl">
      <p class="mb-2 font-mono text-xs uppercase tracking-[0.18em] text-[#9A3412]">Model directory</p>
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">All {models.length} models, one profile each</h1>
      <p class="mt-4 text-lg leading-relaxed text-[#4A4740]">
        Every model we track, grouped by provider. Each profile page has verified per-token rates, the context
        window in human terms (words and pages), and what the model costs per month at three real workloads.
        All data verified as of <strong>{lastCheck}</strong>.
      </p>
    </header>

    {
      groups.map((g) => (
        <section class="mt-10" aria-label={`${g.provider} models`}>
          <h2 class="text-2xl font-bold tracking-tight">{g.provider}</h2>
          <div class="mt-4 overflow-x-auto rounded-xl border border-[#E5E1D7] bg-white">
            <table class="w-full min-w-[560px] border-collapse text-sm">
              <thead>
                <tr class="border-b-2 border-[#1C1B18] text-left text-xs uppercase tracking-wide text-[#6E6A60]">
                  <th class="px-4 py-3">Model</th>
                  <th class="px-4 py-3">Input /1M</th>
                  <th class="px-4 py-3">Output /1M</th>
                  <th class="px-4 py-3">Context</th>
                  <th class="px-4 py-3">Verified</th>
                </tr>
              </thead>
              <tbody>
                {g.list.map((m) => (
                  <tr class="border-b border-[#E5E1D7] last:border-0 hover:bg-[#FBFAF7]">
                    <td class="px-4 py-3">
                      <a href={`/models/${m.id}/`} class="font-medium text-[#0F6B5C] hover:underline">{m.name}</a>
                    </td>
                    <td class="px-4 py-3 font-mono font-semibold text-[#0F6B5C]">{fmtPrice(m.inputPer1M)}</td>
                    <td class="px-4 py-3 font-mono">{fmtPrice(m.outputPer1M)}</td>
                    <td class="px-4 py-3 font-mono text-[#6E6A60]">{fmtContext(m.contextWindow)}</td>
                    <td class="px-4 py-3 text-xs text-[#6E6A60]">{m.lastChecked}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      ))
    }

    <!-- ============ FAQ ============ -->
    <section class="mt-14 max-w-2xl">
      <h2 class="text-2xl font-bold tracking-tight">Frequently asked questions</h2>
      <div class="mt-6 divide-y divide-[#E5E1D7]">
        {
          faqs.map((f) => (
            <details class="group py-4">
              <summary class="cursor-pointer list-none font-medium marker:hidden">
                <span class="flex items-start justify-between gap-4">
                  {f.q}
                  <span class="mt-1 text-[#6E6A60] transition group-open:rotate-45" aria-hidden="true">+</span>
                </span>
              </summary>
              <p class="mt-3 leading-relaxed text-[#4A4740]">{f.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <!-- ============ RELATED ============ -->
    <section class="mt-14 rounded-xl border border-[#E5E1D7] bg-[#F1EEE7] p-6">
      <h2 class="text-lg font-bold tracking-tight">Keep exploring</h2>
      <p class="mt-3 text-sm leading-relaxed text-[#4A4740]">
        All rates side by side on the <a href="/tools/llm-pricing/" class="font-medium text-[#0F6B5C] underline">Pricing Comparison</a>,
        model-vs-model verdicts on the <a href="/compare/" class="font-medium text-[#0F6B5C] underline">comparison hub</a>,
        or your real numbers through the <a href="/tools/cost-calculator/" class="font-medium text-[#0F6B5C] underline">API Cost Calculator</a>.
      </p>
    </section>
  </article>
</BaseLayout>
