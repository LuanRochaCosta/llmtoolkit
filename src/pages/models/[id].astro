---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { models } from '../../data/models';
import {
  comparePairs,
  costScenarios,
  monthlyCost,
  fmtMoney,
  fmtPrice,
  fmtContext,
  buildModelFaqs,
} from '../../data/comparisons';

export function getStaticPaths() {
  return models.map((m) => ({ params: { id: m.id } }));
}

const m = models.find((x) => x.id === Astro.params.id) ?? models[0];
const faqs = buildModelFaqs(m);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const words = Math.round(m.contextWindow * 0.75);
const pages = Math.round(words / 500);
const fillCost = (m.contextWindow / 1_000_000) * (m.inputPer1M ?? 0);
const outputMultiple = m.outputPer1M && m.inputPer1M ? (m.outputPer1M / m.inputPer1M).toFixed(1) : null;

const specRows = [
  { label: 'Input / 1M tokens', value: fmtPrice(m.inputPer1M) },
  { label: 'Cached input / 1M', value: fmtPrice(m.cachedInputPer1M) },
  { label: 'Output / 1M tokens', value: fmtPrice(m.outputPer1M) },
  { label: 'Context window', value: `${fmtContext(m.contextWindow)} tokens` },
  { label: '≈ English words of context', value: words.toLocaleString('en-US') },
  { label: 'Provider', value: m.provider },
  { label: 'Price verified', value: m.lastChecked },
];

const scenarios = costScenarios.map((s) => ({
  label: s.label,
  detail:
    (s.requests / 1000).toLocaleString('en-US') + 'K req · ' +
    s.tokensIn.toLocaleString('en-US') + ' in · ' +
    s.tokensOut.toLocaleString('en-US') + ' out · ' +
    Math.round(s.cacheRate * 100) + '% cached',
  cost: monthlyCost(m, s),
  perRequest: monthlyCost(m, s) / s.requests,
}));

const pairs = comparePairs.filter((p) => p.a.id === m.id || p.b.id === m.id);
const siblings = models.filter((x) => x.provider === m.provider && x.id !== m.id);

const desc =
  m.name + ' API pricing: ' + fmtPrice(m.inputPer1M) + ' input and ' + fmtPrice(m.outputPer1M) +
  ' output per 1M tokens, ' + fmtContext(m.contextWindow) + ' context window, cached input at ' +
  fmtPrice(m.cachedInputPer1M) + '. Verified against the official ' + m.provider + ' pricing page.';
---

<BaseLayout
  title={`${m.name} API Pricing & Context Window (2026)`}
  description={desc}
  dateModified={m.lastChecked}
  extraSchemas={[faqSchema]}
>
  <article>
    <header class="max-w-2xl">
      <p class="mb-2 font-mono text-xs uppercase tracking-[0.18em] text-[#9A3412]">Model profile · {m.provider}</p>
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{m.name} pricing</h1>
      <p class="mt-4 text-lg leading-relaxed text-[#4A4740]">
        {m.name} costs <strong>{fmtPrice(m.inputPer1M)} per 1M input tokens</strong> and
        <strong> {fmtPrice(m.outputPer1M)} per 1M output tokens</strong>, with a
        <strong> {fmtContext(m.contextWindow)} context window</strong>. Rates verified against the official
        {m.provider} pricing page as of {m.lastChecked}.
        {m.note && <span class="block mt-2 text-sm text-[#9A3412]">{m.note}.</span>}
      </p>
    </header>

    <!-- ============ VERDICT ============ -->
    <section class="mt-8 grid gap-4 sm:grid-cols-3" aria-label="Key specs">
      <div class="rounded-xl border border-[#E5E1D7] bg-white p-5">
        <p class="text-xs font-medium uppercase tracking-wide text-[#6E6A60]">Input</p>
        <p class="mt-1 font-mono text-xl font-bold text-[#0F6B5C]">{fmtPrice(m.inputPer1M)}<span class="text-sm font-normal text-[#6E6A60]"> /1M in</span></p>
        {m.cachedInputPer1M != null && <p class="mt-1 text-xs text-[#6E6A60]">cached: {fmtPrice(m.cachedInputPer1M)}</p>}
      </div>
      <div class="rounded-xl border border-[#E5E1D7] bg-white p-5">
        <p class="text-xs font-medium uppercase tracking-wide text-[#6E6A60]">Output</p>
        <p class="mt-1 font-mono text-xl font-bold text-[#0F6B5C]">{fmtPrice(m.outputPer1M)}<span class="text-sm font-normal text-[#6E6A60]"> /1M out</span></p>
        {outputMultiple && <p class="mt-1 text-xs text-[#6E6A60]">{outputMultiple}× the input rate</p>}
      </div>
      <div class="rounded-xl border border-[#E5E1D7] bg-white p-5">
        <p class="text-xs font-medium uppercase tracking-wide text-[#6E6A60]">Context window</p>
        <p class="mt-1 font-mono text-xl font-bold text-[#0F6B5C]">{fmtContext(m.contextWindow)}<span class="text-sm font-normal text-[#6E6A60]"> tokens</span></p>
        <p class="mt-1 text-xs text-[#6E6A60]">≈ {words.toLocaleString('en-US')} words</p>
      </div>
    </section>

    <!-- ============ SPEC TABLE ============ -->
    <section class="mt-10" aria-label="Specification table">
      <h2 class="text-2xl font-bold tracking-tight">{m.name} at a glance</h2>
      <div class="mt-4 overflow-x-auto rounded-xl border border-[#E5E1D7] bg-white">
        <table class="w-full min-w-[420px] border-collapse text-sm">
          <tbody>
            {
              specRows.map((r) => (
                <tr class="border-b border-[#E5E1D7] last:border-0 hover:bg-[#FBFAF7]">
                  <td class="px-4 py-3 text-[#6E6A60]">{r.label}</td>
                  <td class="px-4 py-3 text-right font-mono font-medium">{r.value}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs leading-relaxed text-[#6E6A60]">
        Source: <a href={m.source} class="font-medium text-[#0F6B5C] underline" rel="nofollow">{m.provider} official pricing page</a>.
        We re-verify every model monthly.
      </p>
    </section>

    <!-- ============ SCENARIOS ============ -->
    <section class="mt-10" aria-label="Workload costs">
      <h2 class="text-2xl font-bold tracking-tight">What {m.name} costs per month</h2>
      <div class="mt-4 overflow-x-auto rounded-xl border border-[#E5E1D7] bg-white">
        <table class="w-full min-w-[560px] border-collapse text-sm">
          <thead>
            <tr class="border-b-2 border-[#1C1B18] text-left text-xs uppercase tracking-wide text-[#6E6A60]">
              <th class="px-4 py-3">Workload</th>
              <th class="px-4 py-3">{m.name} monthly cost</th>
              <th class="px-4 py-3">Per request</th>
            </tr>
          </thead>
          <tbody>
            {
              scenarios.map((s) => (
                <tr class="border-b border-[#E5E1D7] last:border-0 hover:bg-[#FBFAF7]">
                  <td class="px-4 py-3">
                    <span class="font-medium">{s.label}</span>
                    <span class="block text-xs text-[#6E6A60]">{s.detail}</span>
                  </td>
                  <td class="px-4 py-3 font-mono font-bold text-[#0F6B5C]">{fmtMoney(s.cost)}<span class="block text-xs font-normal text-[#6E6A60]">/mo</span></td>
                  <td class="px-4 py-3 font-mono text-[#6E6A60]">{fmtMoney(s.perRequest)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs leading-relaxed text-[#6E6A60]">
        Computed from list prices verified {m.lastChecked}. Cache savings blend normal and cached input rates by the
        hit rate. Compare against every other model at your exact volumes on the
        <a href="/tools/cost-calculator/" class="font-medium text-[#0F6B5C] underline">API Cost Calculator</a>.
      </p>
    </section>

    <!-- ============ CONTEXT ============ -->
    <section class="mt-10 max-w-2xl" aria-label="Context in human terms">
      <h2 class="text-2xl font-bold tracking-tight">How much context is {fmtContext(m.contextWindow)} tokens?</h2>
      <p class="mt-4 leading-relaxed text-[#4A4740]">
        About {words.toLocaleString('en-US')} English words — roughly {pages.toLocaleString('en-US')} pages of text —
        or several large codebases. Filling the entire window once costs
        <strong>{fmtMoney(fillCost)} in input tokens</strong> at list price, before the model generates a single
        output token. Count your real documents with the
        <a href="/tools/token-counter/" class="font-medium text-[#0F6B5C] underline">AI Token Counter</a>.
      </p>
    </section>

    <!-- ============ FAQ ============ -->
    <section class="mt-14 max-w-2xl">
      <h2 class="text-2xl font-bold tracking-tight">Frequently asked questions</h2>
      <div class="mt-6 divide-y divide-[#E5E1D7]">
        {
          faqs.map((f) => (
            <details class="group py-4">
              <summary class="cursor-pointer list-none font-medium marker:hidden">
                <span class="flex items-start justify-between gap-4">
                  {f.q}
                  <span class="mt-1 text-[#6E6A60] transition group-open:rotate-45" aria-hidden="true">+</span>
                </span>
              </summary>
              <p class="mt-3 leading-relaxed text-[#4A4740]">{f.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <!-- ============ RELATED ============ -->
    <section class="mt-14 grid gap-4 sm:grid-cols-2" aria-label="Related pages">
      {
        pairs.length > 0 && (
          <div class="rounded-xl border border-[#E5E1D7] bg-[#F1EEE7] p-6">
            <h2 class="text-lg font-bold tracking-tight">Compare {m.name} against</h2>
            <ul class="mt-3 list-disc space-y-2 pl-5 text-sm">
              {pairs.map((p) => (
                <li>
                  <a href={`/compare/${p.slug}/`} class="font-medium text-[#0F6B5C] underline">
                    {p.a.id === m.id ? p.b.name : p.a.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
      <div class="rounded-xl border border-[#E5E1D7] bg-[#F1EEE7] p-6">
        <h2 class="text-lg font-bold tracking-tight">More {m.provider} models</h2>
        <ul class="mt-3 list-disc space-y-2 pl-5 text-sm">
          {
            siblings.slice(0, 8).map((s) => (
              <li>
                <a href={`/models/${s.id}/`} class="font-medium text-[#0F6B5C] underline">{s.name}</a>
                <span class="ml-2 font-mono text-xs text-[#6E6A60]">{fmtPrice(s.inputPer1M)} in · {fmtContext(s.contextWindow)}</span>
              </li>
            ))
          }
        </ul>
        <p class="mt-4 text-sm leading-relaxed text-[#4A4740]">
          Or see all rates on the <a href="/tools/llm-pricing/" class="font-medium text-[#0F6B5C] underline">Pricing Comparison</a>.
        </p>
      </div>
    </section>
  </article>
</BaseLayout>
