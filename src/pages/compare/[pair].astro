---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { comparePairs, costScenarios, monthlyCost, fmtMoney, fmtPrice, fmtContext, buildPairFaqs } from '../../data/comparisons';

export function getStaticPaths() {
  return comparePairs.map((p) => ({ params: { pair: p.slug } }));
}

const pair = comparePairs.find((p) => p.slug === Astro.params.pair) ?? comparePairs[0];
const A = pair.a;
const B = pair.b;

const cheaperIn = (A.inputPer1M ?? Infinity) <= (B.inputPer1M ?? Infinity) ? A : B;
const cheaperOut = (A.outputPer1M ?? Infinity) <= (B.outputPer1M ?? Infinity) ? A : B;
const biggerCtx = A.contextWindow >= B.contextWindow ? A : B;

const aCheaperIn = (A.inputPer1M ?? Infinity) < (B.inputPer1M ?? Infinity);
const aCheaperCache = (A.cachedInputPer1M ?? Infinity) < (B.cachedInputPer1M ?? Infinity);
const bCheaperOut = (B.outputPer1M ?? Infinity) < (A.outputPer1M ?? Infinity);

const other = comparePairs.filter((p) => p.slug !== Astro.params.pair).slice(0, 8);

const faqs = buildPairFaqs(A, B);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const specRows = [
  { label: 'Input / 1M tokens', a: fmtPrice(A.inputPer1M), b: fmtPrice(B.inputPer1M) },
  { label: 'Cached input / 1M', a: fmtPrice(A.cachedInputPer1M), b: fmtPrice(B.cachedInputPer1M) },
  { label: 'Output / 1M tokens', a: fmtPrice(A.outputPer1M), b: fmtPrice(B.outputPer1M) },
  { label: 'Context window', a: fmtContext(A.contextWindow), b: fmtContext(B.contextWindow) },
  { label: 'Provider', a: A.provider, b: B.provider },
  { label: 'Price verified', a: A.lastChecked, b: B.lastChecked },
];

const scenarios = costScenarios.map((s) => ({
  label: s.label,
  detail:
    (s.requests / 1000).toLocaleString('en-US') + 'K req · ' +
    s.tokensIn.toLocaleString('en-US') + ' in / ' +
    s.tokensOut.toLocaleString('en-US') + ' out · ' +
    Math.round(s.cacheRate * 100) + '% cached',
  a: monthlyCost(A, s),
  b: monthlyCost(B, s),
}));
---

<BaseLayout
  title={`${A.name} vs ${B.name}: API Pricing & Context Compared (2026)`}
  description={`${A.name} vs ${B.name} — verified per-token pricing, cached rates, context windows and monthly cost at three real workloads. Input from ${fmtPrice(A.inputPer1M)} vs ${fmtPrice(B.inputPer1M)} per 1M tokens.`}
  dateModified="2026-08-26"
  extraSchemas={[faqSchema]}
>
  <article>
    <header class="max-w-2xl">
      <p class="mb-2 font-mono text-xs uppercase tracking-[0.18em] text-[#9A3412]">Model comparison</p>
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{A.name} vs {B.name}</h1>
      <p class="mt-4 text-lg leading-relaxed text-[#4A4740]">
        Verified pricing, context windows and real-workload costs for both models — computed from
        official provider rates as of {A.lastChecked}.
      </p>
    </header>

    <!-- ============ VERDICT ============ -->
    <section class="mt-8 grid gap-4 sm:grid-cols-3" aria-label="Verdict">
      <div class="rounded-xl border border-[#E5E1D7] bg-white p-5">
        <p class="text-xs font-medium uppercase tracking-wide text-[#6E6A60]">Cheaper input</p>
        <p class="mt-1.5 font-semibold">{cheaperIn.name}</p>
        <p class="mt-1 font-mono text-xl font-bold text-[#0F6B5C]">{fmtPrice(cheaperIn.inputPer1M)}<span class="text-sm font-normal text-[#6E6A60]"> /1M in</span></p>
      </div>
      <div class="rounded-xl border border-[#E5E1D7] bg-white p-5">
        <p class="text-xs font-medium uppercase tracking-wide text-[#6E6A60]">Cheaper output</p>
        <p class="mt-1.5 font-semibold">{cheaperOut.name}</p>
        <p class="mt-1 font-mono text-xl font-bold text-[#0F6B5C]">{fmtPrice(cheaperOut.outputPer1M)}<span class="text-sm font-normal text-[#6E6A60]"> /1M out</span></p>
      </div>
      <div class="rounded-xl border border-[#E5E1D7] bg-white p-5">
        <p class="text-xs font-medium uppercase tracking-wide text-[#6E6A60]">Bigger context</p>
        <p class="mt-1.5 font-semibold">{biggerCtx.name}</p>
        <p class="mt-1 font-mono text-xl font-bold text-[#0F6B5C]">{fmtContext(biggerCtx.contextWindow)}<span class="text-sm font-normal text-[#6E6A60]"> tokens</span></p>
      </div>
    </section>

    <!-- ============ SPEC TABLE ============ -->
    <section class="mt-10" aria-label="Specification table">
      <h2 class="text-2xl font-bold tracking-tight">Head to head</h2>
      <div class="mt-4 overflow-x-auto rounded-xl border border-[#E5E1D7] bg-white">
        <table class="w-full min-w-[480px] border-collapse text-sm">
          <thead>
            <tr class="border-b-2 border-[#1C1B18] text-left text-xs uppercase tracking-wide text-[#6E6A60]">
              <th class="px-4 py-3">Spec</th>
              <th class="px-4 py-3">{A.name}</th>
              <th class="px-4 py-3">{B.name}</th>
            </tr>
          </thead>
          <tbody>
            {
              specRows.map((r) => (
                <tr class="border-b border-[#E5E1D7] last:border-0 hover:bg-[#FBFAF7]">
                  <td class="px-4 py-3 text-[#6E6A60]">{r.label}</td>
                  <td class="px-4 py-3 font-mono font-medium">{r.a}</td>
                  <td class="px-4 py-3 font-mono font-medium">{r.b}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <!-- ============ SCENARIOS ============ -->
    <section class="mt-10" aria-label="Workload costs">
      <h2 class="text-2xl font-bold tracking-tight">Monthly cost at three real workloads</h2>
      <div class="mt-4 overflow-x-auto rounded-xl border border-[#E5E1D7] bg-white">
        <table class="w-full min-w-[560px] border-collapse text-sm">
          <thead>
            <tr class="border-b-2 border-[#1C1B18] text-left text-xs uppercase tracking-wide text-[#6E6A60]">
              <th class="px-4 py-3">Workload</th>
              <th class="px-4 py-3">{A.name}</th>
              <th class="px-4 py-3">{B.name}</th>
              <th class="px-4 py-3">Winner</th>
            </tr>
          </thead>
          <tbody>
            {
              scenarios.map((s) => {
                const winner = s.b >= s.a ? A : B;
                return (
                  <tr class="border-b border-[#E5E1D7] last:border-0 hover:bg-[#FBFAF7]">
                    <td class="px-4 py-3">
                      <span class="font-medium">{s.label}</span>
                      <span class="block text-xs text-[#6E6A60]">{s.detail}</span>
                    </td>
                    <td class={`px-4 py-3 font-mono ${s.b >= s.a ? 'font-bold text-[#0F6B5C]' : ''}`}>{fmtMoney(s.a)}<span class="block text-xs font-normal text-[#6E6A60]">/mo</span></td>
                    <td class={`px-4 py-3 font-mono ${s.a > s.b ? 'font-bold text-[#0F6B5C]' : ''}`}>{fmtMoney(s.b)}<span class="block text-xs font-normal text-[#6E6A60]">/mo</span></td>
                    <td class="px-4 py-3 text-xs font-medium">{winner.name}</td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs leading-relaxed text-[#6E6A60]">
        Computed from list prices verified {A.lastChecked}. Cache savings blend normal and cached input rates by the
        hit rate; models without published cached rates use the base input price. Adjust every parameter yourself on
        the <a href="/tools/cost-calculator/" class="font-medium text-[#0F6B5C] underline">API Cost Calculator</a>.
      </p>
    </section>

    <!-- ============ WHEN TO PICK ============ -->
    <section class="mt-10 grid gap-4 sm:grid-cols-2" aria-label="Recommendations">
      <div class="rounded-xl border border-[#E5E1D7] bg-white p-6">
        <h2 class="text-lg font-bold tracking-tight">Pick {A.name} if…</h2>
        <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-relaxed text-[#4A4740]">
          <li>{aCheaperIn ? `Input cost dominates your bill — it charges ${fmtPrice(A.inputPer1M)} per 1M input vs ${fmtPrice(B.inputPer1M)}.` : `You prefer its ${fmtPrice(A.inputPer1M)} input rate for read-heavy workloads.`}</li>
          <li>{A.contextWindow >= B.contextWindow ? `You need the larger ${fmtContext(A.contextWindow)} context window.` : `Your documents fit its ${fmtContext(A.contextWindow)} window comfortably.`}</li>
          <li>{aCheaperCache ? `You run repeat-context workloads — cached input at ${fmtPrice(A.cachedInputPer1M)} per 1M is the better deal.` : 'You value its provider ecosystem and tooling.'}</li>
        </ul>
      </div>
      <div class="rounded-xl border border-[#E5E1D7] bg-white p-6">
        <h2 class="text-lg font-bold tracking-tight">Pick {B.name} if…</h2>
        <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-relaxed text-[#4A4740]">
          <li>{bCheaperOut ? `You generate long outputs — ${fmtPrice(B.outputPer1M)} per 1M output vs ${fmtPrice(A.outputPer1M)} adds up fast.` : `Output-heavy agent loops favor its ${fmtPrice(B.outputPer1M)} output rate.`}</li>
          <li>{B.contextWindow > A.contextWindow ? `You need ${fmtContext(B.contextWindow)} tokens of context for large codebases or document sets.` : `Its ${fmtContext(B.contextWindow)} window covers your typical request with headroom.`}</li>
          <li>You want cheaper total spend at your exact volumes — verify with the calculator above.</li>
        </ul>
      </div>
    </section>

    <!-- ============ FAQ ============ -->
    <section class="mt-14 max-w-2xl">
      <h2 class="text-2xl font-bold tracking-tight">Frequently asked questions</h2>
      <div class="mt-6 divide-y divide-[#E5E1D7]">
        {
          faqs.map((f) => (
            <details class="group py-4">
              <summary class="cursor-pointer list-none font-medium marker:hidden">
                <span class="flex items-start justify-between gap-4">
                  {f.q}
                  <span class="mt-1 text-[#6E6A60] transition group-open:rotate-45" aria-hidden="true">+</span>
                </span>
              </summary>
              <p class="mt-3 leading-relaxed text-[#4A4740]">{f.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <!-- ============ RELATED ============ -->
    <section class="mt-14 rounded-xl border border-[#E5E1D7] bg-[#F1EEE7] p-6">
      <h2 class="text-lg font-bold tracking-tight">Keep comparing</h2>
      <ul class="mt-3 grid gap-2 text-sm sm:grid-cols-2">
        {
          other.map((p) => (
            <li>
              <a href={`/compare/${p.slug}/`} class="font-medium text-[#0F6B5C] underline">{p.a.name} vs {p.b.name}</a>
            </li>
          ))
        }
      </ul>
      <p class="mt-4 text-sm leading-relaxed text-[#4A4740]">
        Or measure your real usage with the <a href="/tools/token-counter/" class="font-medium text-[#0F6B5C] underline">AI Token Counter</a> and
        browse all rates on the <a href="/tools/llm-pricing/" class="font-medium text-[#0F6B5C] underline">Pricing Comparison</a>.
      </p>
    </section>
  </article>
</BaseLayout>
