---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolCard from '../../components/ToolCard.astro';
import { tools } from '../../data/tools';

const liveTools = tools.filter((t) => t.status === 'live');

const faqs = [
  {
    q: 'Are these LLM tools really free?',
    a: 'Yes. Every tool on this site is a static page that runs 100% in your browser — no sign-up, no API keys, no server calls. Paste an entire novel into the Token Counter and nothing is uploaded; the count happens locally on your device.',
  },
  {
    q: 'Which tool should I start with?',
    a: 'If you are budgeting an API project, start with the Pricing Comparison to see verified rates for 22 models side by side, then feed your request volume and cache profile into the Cost Calculator. If you already have prompts or documents, measure real usage with the Token Counter first — every other number flows from your true token counts.',
  },
  {
    q: 'How current is the pricing data behind the tools?',
    a: 'Every rate shown in the Pricing Comparison and Cost Calculator is verified against official OpenAI, Anthropic and Google pricing pages, and every row carries its verification date. Promotional rates are labeled with their expiry — for example, GPT-5.6 Sol runs $4.00 per 1M input tokens at least through November 21, 2026 before reverting.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title="All Tools — Token Counter, Pricing Table, Cost Calculator & Context Windows"
  description="Five free, privacy-first browser tools for LLM developers: an exact AI token counter, a verified API pricing table for 22 models, a monthly cost calculator, a context window comparison and a token-to-words converter. No sign-up, nothing leaves your browser."
  dateModified="2026-09-02"
  extraSchemas={[faqSchema]}
>
  <article>
    <header class="max-w-2xl">
      <p class="mb-2 font-mono text-xs uppercase tracking-[0.18em] text-[#9A3412]">Tools directory</p>
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">The complete LLM toolkit</h1>
      <p class="mt-4 text-lg leading-relaxed text-[#4A4740]">
        {liveTools.length} free tools that run entirely in your browser — measure tokens, check verified
        per-token rates, and model your real monthly bill. No accounts, no API keys, no data collection.
      </p>
    </header>

    <section class="mt-10 grid gap-3 sm:grid-cols-2">
      {tools.map((tool) => <ToolCard tool={tool} />)}
    </section>

    <section class="mt-14 max-w-2xl">
      <h2 class="text-2xl font-bold tracking-tight">How the tools fit together</h2>
      <p class="mt-4 leading-relaxed text-[#4A4740]">
        A typical workflow: paste your prompt or document into the
        <a href="/tools/token-counter/" class="font-medium text-[#0F6B5C] underline">AI Token Counter</a> to
        get exact token counts and context-window usage, check what each model charges on the
        <a href="/tools/llm-pricing/" class="font-medium text-[#0F6B5C] underline">Pricing Comparison</a>,
        then enter your request volume and cache hit rate into the
        <a href="/tools/cost-calculator/" class="font-medium text-[#0F6B5C] underline">API Cost Calculator</a>
        to see the monthly bill for every model at once. Long documents? The
        <a href="/tools/context-window/" class="font-medium text-[#0F6B5C] underline">Context Window Comparison</a>
        shows which models fit your text, and the
        <a href="/tools/token-words/" class="font-medium text-[#0F6B5C] underline">Token-Words Converter</a>
        translates between tokens, words and pages.
      </p>
    </section>

    <section class="mt-14 max-w-2xl">
      <h2 class="text-2xl font-bold tracking-tight">Frequently asked questions</h2>
      <div class="mt-6 divide-y divide-[#E5E1D7]">
        {
          faqs.map((f) => (
            <details class="group py-4">
              <summary class="cursor-pointer list-none font-medium marker:hidden">
                <span class="flex items-start justify-between gap-4">
                  {f.q}
                  <span class="mt-1 text-[#6E6A60] transition group-open:rotate-45" aria-hidden="true">+</span>
                </span>
              </summary>
              <p class="mt-3 leading-relaxed text-[#4A4740]">{f.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <section class="mt-14 grid gap-3 sm:grid-cols-2">
      <a
        href="/models/"
        class="group rounded-xl border border-[#E5E1D7] bg-white p-5 transition hover:border-[#0F6B5C]"
      >
        <p class="font-semibold group-hover:text-[#0F6B5C]">Model directory</p>
        <p class="mt-1 text-sm leading-relaxed text-[#6E6A60]">
          One profile page per tracked model — verified rates, context windows in words and pages, and
          monthly cost at three real workloads.
        </p>
      </a>
      <a
        href="/compare/"
        class="group rounded-xl border border-[#E5E1D7] bg-white p-5 transition hover:border-[#0F6B5C]"
      >
        <p class="font-semibold group-hover:text-[#0F6B5C]">Comparison hub</p>
        <p class="mt-1 text-sm leading-relaxed text-[#6E6A60]">
          28 head-to-head matchups with per-token rates, context windows and workload-priced monthly
          costs for every pair.
        </p>
      </a>
    </section>
  </article>
</BaseLayout>
