---
import type { Tool } from '../data/tools';

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
const isLive = tool.status === 'live';
---

{
  isLive ? (
    <a
      href={`/tools/${tool.slug}`}
      class="group flex flex-col rounded-xl border border-[#E5E1D7] bg-white p-6 transition hover:border-[#0F6B5C] hover:shadow-sm"
    >
      <div class="mb-2 flex items-center justify-between">
        <h3 class="font-semibold tracking-tight group-hover:text-[#0F6B5C]">{tool.name}</h3>
        <span class="rounded-full bg-[#0F6B5C]/10 px-2.5 py-0.5 text-xs font-medium text-[#0F6B5C]">Live</span>
      </div>
      <p class="text-sm leading-relaxed text-[#6E6A60]">{tool.description}</p>
    </a>
  ) : (
    <div class="flex flex-col rounded-xl border border-dashed border-[#E5E1D7] bg-white/60 p-6">
      <div class="mb-2 flex items-center justify-between">
        <h3 class="font-semibold tracking-tight text-[#1C1B18]/80">{tool.name}</h3>
        <span class="rounded-full bg-[#F1EEE7] px-2.5 py-0.5 text-xs font-medium text-[#6E6A60]">Coming soon</span>
      </div>
      <p class="text-sm leading-relaxed text-[#6E6A60]">{tool.description}</p>
    </div>
  )
}
